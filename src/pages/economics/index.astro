---
import { withBase } from '../../lib/path';
import { getCollection } from 'astro:content';
import SectionLayout from '../../layouts/SectionLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
const lessons = (await getCollection('lessons', ({ data }) => data.section === 'economics')).sort((a, b) => a.data.order - b.data.order);
const lessonLabels: Record<number, string> = { 1: 'L1', 2: 'L2', 3: 'L3', 4: 'L4&5' };
---
<SectionLayout title="Alan's Economics Commons" introduction="Economics is a subject about making choices." section="economics" heroImage="/images/economics/economics-hero.png" heroImageAlt="A cute plush toy of a traditional Chinese building with SJTU badge">
  <div class="lesson-list">
    {lessons.map((lesson) => {
      const slug = lesson.id.replace(/^economics\//, '').replace(/\.mdx$/, '');
      return <CourseCard number={lessonLabels[lesson.data.order] ?? `L${lesson.data.order}`} title={lesson.data.title} description={lesson.data.description} href={`/economics/${slug}/`} />;
    })}
    <a class="qa-link" href={withBase('/economics/q-and-a/')}>
      <img class="qa-link__hedwig" src={withBase('/images/economics/hedwig.png')} alt="Hedwig the owl" loading="lazy" />
      <span class="qa-link__title">Q&amp;A Sessions</span>
      <span class="qa-link__arrow" aria-hidden="true">→</span>
    </a>
  </div>
</SectionLayout>
<style>
  .lesson-list { padding-bottom: var(--space-6); }
  .qa-link { align-items: center; color: var(--color-ink); display: inline-flex; font-family: var(--font-display); gap: clamp(.7rem, 2vw, 1.3rem); margin-top: var(--space-4); text-decoration: none; }
  .qa-link__hedwig { flex: 0 0 auto; height: auto; width: clamp(7rem, 14vw, 10.5rem); }
  .qa-link__title { font-size: clamp(1.45rem, 3vw, 2rem); }
  .qa-link__arrow { font-size: clamp(1.25rem, 2.6vw, 1.75rem); }
  .qa-link:hover { color: var(--color-accent); }
  @media (max-width: 36rem) {
    .qa-link { gap: .75rem; }
    .qa-link__hedwig { width: clamp(6.5rem, 29vw, 8rem); }
  }
</style>
