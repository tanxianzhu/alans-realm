---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Alan's English Corner — Alan's Realm" description="English topics for Alan's Realm." currentSection="english">
  <section class="site-shell english-intro">
    <p>Alan's Realm · English Corner</p>
    <h1>Alan's English Corner</h1>
  </section>
  <section class="site-shell english-topics" aria-labelledby="topics">
    <p class="english-topics__number">01</p>
    <div>
      <h2 id="topics">Topics</h2>
      <p>Topics are in development.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .english-intro { border-bottom: 1px solid var(--color-line); padding: clamp(5rem, 12vw, 10rem) 0 var(--space-5); }
  .english-intro > p, .english-topics__number { color: var(--color-muted); font-size: var(--size-xs); letter-spacing: .12em; margin-bottom: var(--space-2); text-transform: uppercase; }
  .english-intro h1 { font-size: var(--size-xl); margin-bottom: 0; max-width: 13ch; }
  .english-topics { display: grid; gap: var(--space-2); grid-template-columns: 2.5rem minmax(0, 1fr); padding: var(--space-6) 0; }
  .english-topics__number { color: var(--color-accent); margin: .45rem 0 0; }
  .english-topics h2 { font-size: clamp(2.4rem, 6vw, 4.5rem); margin-bottom: var(--space-2); }
  .english-topics div > p { color: var(--color-muted); font-family: var(--font-display); font-size: var(--size-lg); }
</style>
