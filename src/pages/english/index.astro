---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/path';
---

<BaseLayout title="Alan's English Corner — Alan's Realm" description="English topics for Alan's Realm." currentSection="english">
  <section class="site-shell english-intro">
    <p>Alan's Realm · English Corner</p>
    <h1>Alan's English Corner</h1>
    <img class="english-intro__warrior" src={withBase('/images/english/roman-warrior.png')} alt="A plush Roman warrior" loading="eager" />
  </section>
  <section class="site-shell english-letter" aria-labelledby="catch-up-night">
    <div class="english-letter__index" aria-hidden="true">01</div>
    <div class="english-letter__content">
      <p>Hi there!</p>
      <p>Long time no see — we’ve missed you so much! How’s your new semester going? Any funny stories or random thoughts you want to share? Well, at least I'll bring something interesting to the table, so that we can think about, talk about, and explore together, and we’ll see where the conversation takes us.</p>
      <p>So… wanna have a short chat with us?</p>
      <div class="english-letter__event">
        <h2 id="catch-up-night">Alan &amp; Judy’s<br />Catch-Up Night</h2>
        <p>📅 September 12, 2026<br />🕖 19:00–20:00 <span>(can be rescheduled if needed)</span></p>
      </div>
      <a class="english-letter__signup" href="https://meeting.tencent.com/dm/WI68bEpqqykl" target="_blank" rel="noreferrer">Click here to sign up <span aria-hidden="true">→</span></a>
      <p class="english-letter__meeting"># 腾讯会议：553-398-036</p>
      <p>Feel free to email Alan at <a href="mailto:xtaoag@connect.ust.hk">xtaoag@connect.ust.hk</a> to share topics you’d like to talk about or any other ideas you have.</p>
      <p>Hope to see you there!</p>
    </div>
  </section>
</BaseLayout>

<style>
  .english-intro { border-bottom: 1px solid var(--color-line); padding: clamp(5rem, 12vw, 10rem) 0 var(--space-5); }
  .english-intro > p, .english-letter__index { color: var(--color-muted); font-size: var(--size-xs); letter-spacing: .12em; margin-bottom: var(--space-2); text-transform: uppercase; }
  .english-intro h1 { font-size: var(--size-xl); margin-bottom: 0; max-width: 13ch; }
  .english-intro__warrior { display: block; margin-top: clamp(2rem, 5vw, 3.75rem); max-width: min(42vw, 25rem); width: 100%; }
  .english-letter { display: grid; gap: var(--space-2); grid-template-columns: 2.5rem minmax(0, 42rem); padding: var(--space-6) 0; }
  .english-letter__index { color: var(--color-accent); margin: .45rem 0 0; }
  .english-letter__content { color: var(--color-muted); font-family: var(--font-display); font-size: var(--size-lg); line-height: 1.5; }
  .english-letter__content > p { margin-bottom: 1.5rem; }
  .english-letter__event { border-left: 1px solid var(--color-accent); color: var(--color-ink); margin: clamp(2.5rem, 6vw, 4rem) 0 2rem; padding-left: clamp(1.25rem, 3vw, 2rem); }
  .english-letter__event h2 { font-size: clamp(2.35rem, 5vw, 4.2rem); margin-bottom: 1rem; }
  .english-letter__event p { font-family: var(--font-body); font-size: var(--size-base); line-height: 1.7; margin: 0; }
  .english-letter__event span { color: var(--color-muted); }
  .english-letter__signup { align-items: center; color: var(--color-accent); display: inline-flex; font-family: var(--font-body); font-size: var(--size-sm); font-weight: 600; gap: .65rem; letter-spacing: .05em; margin-bottom: .85rem; text-decoration: none; }
  .english-letter__signup:hover { color: var(--color-ink); }
  .english-letter__signup span { font-size: 1.2em; }
  .english-letter__meeting { color: var(--color-muted); font-family: var(--font-body); font-size: var(--size-sm); margin-bottom: 2.25rem !important; }
  .english-letter__content a:not(.english-letter__signup) { color: var(--color-ink); }
  @media (max-width: 48rem) { .english-intro__warrior { max-width: min(82vw, 22rem); } }
  @media (max-width: 36rem) { .english-letter { grid-template-columns: 1fr; } .english-letter__index { margin: 0; } }
</style>
