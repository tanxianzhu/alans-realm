---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/path';
---

<BaseLayout title="Alan's English Corner — Alan's Realm" description="English topics for Alan's Realm." currentSection="english">
  <section class="site-shell english-intro">
    <p>Alan's Realm · English Corner</p>
    <h1>Alan's English Corner</h1>
    <img class="english-intro__warrior" src={withBase('/images/english/roman-warrior.png')} alt="A plush Roman warrior" loading="eager" />
  </section>
  <section class="site-shell english-letter" aria-labelledby="catch-up-night">
    <div class="english-letter__content">
      <p class="english-letter__eyebrow">You’re invited</p>
      <h2 class="english-letter__greeting">Hi there!</h2>
      <p>Long time no see — we’ve missed you so much! How’s your new semester going? Any funny stories or random thoughts you want to share? Well, at least I'll bring something interesting to the table, so that we can think about, talk about, and explore together, and we’ll see where the conversation takes us.</p>
      <p class="english-letter__prompt">So… wanna have a short chat with us? 😉</p>
      <div class="english-letter__event">
        <h2 id="catch-up-night"><span>Alan &amp; Judy’s</span><span>Catch-Up Night</span></h2>
        <div class="english-letter__event-details">
          <div class="english-letter__event-detail">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3m10-3v3M4.5 9h15M6 5h12a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 18 19H6a1.5 1.5 0 0 1-1.5-1.5v-11A1.5 1.5 0 0 1 6 5Z" /></svg>
            <p><strong>Date</strong><span>September 12, 2026</span><span>Saturday</span></p>
          </div>
          <div class="english-letter__event-detail">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" /></svg>
            <p><strong>Time</strong><span>19:00–20:00</span><em>can be rescheduled if needed</em></p>
          </div>
        </div>
      </div>
      <a class="english-letter__signup" href="https://meeting.tencent.com/dm/WI68bEpqqykl" target="_blank" rel="noreferrer">Click here to sign up <span aria-hidden="true">→</span></a>
      <p class="english-letter__meeting">Tencent Meeting · 553-398-036</p>
      <p class="english-letter__email">Feel free to email Alan at <a href="mailto:xtaoag@connect.ust.hk">xtaoag@connect.ust.hk</a> if there’s anything you’d especially like to talk about — or simply bring whatever is on your mind.</p>
      <p class="english-letter__closing">Hope to see you there!</p>
    </div>
  </section>
</BaseLayout>

<style>
  .english-intro { border-bottom: 1px solid var(--color-line); padding: clamp(5rem, 12vw, 10rem) 0 var(--space-5); }
  .english-intro > p { color: var(--color-muted); font-size: var(--size-xs); letter-spacing: .12em; margin-bottom: var(--space-2); text-transform: uppercase; }
  .english-intro h1 { font-size: var(--size-xl); margin-bottom: 0; max-width: 13ch; }
  .english-intro__warrior { display: block; margin-top: clamp(2rem, 5vw, 3.75rem); max-width: min(42vw, 25rem); width: 100%; }
  .english-letter { padding: var(--space-6) 0; }
  .english-letter__content { max-width: 42rem; }
  .english-letter__content { color: var(--color-muted); font-family: var(--font-display); font-size: var(--size-lg); line-height: 1.5; }
  .english-letter__content > p { margin-bottom: 1.5rem; }
  .english-letter__eyebrow { align-items: center; color: color-mix(in srgb, var(--color-accent) 56%, var(--color-paper)); display: flex; font-family: var(--font-body); font-size: var(--size-xs); gap: .85rem; letter-spacing: .2em; margin-bottom: .85rem !important; text-transform: uppercase; }
  .english-letter__eyebrow::after { background: color-mix(in srgb, var(--color-accent) 35%, var(--color-paper)); content: ''; flex: 1; height: 1px; }
  .english-letter__greeting { font-size: clamp(3.5rem, 8vw, 6.4rem); line-height: .88; margin-bottom: clamp(2.2rem, 5vw, 3.6rem); }
  .english-letter__prompt { color: var(--color-ink); font-size: clamp(1.55rem, 3vw, 2.25rem); line-height: 1.15; margin: clamp(3.5rem, 8vw, 5.75rem) 0 1.35rem !important; }
  .english-letter__event { background: var(--color-wash); border: 1px solid var(--color-line); border-radius: 1rem; color: var(--color-ink); margin: 0 0 1.6rem; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .english-letter__event h2 { font-size: clamp(1.8rem, 3.8vw, 2.85rem); line-height: 1; margin-bottom: clamp(1.6rem, 4vw, 2.25rem); }
  .english-letter__event h2 span { display: block; }
  .english-letter__event h2 span + span { margin-top: .18em; }
  .english-letter__event-details { display: grid; grid-template-columns: 1fr 1fr; }
  .english-letter__event-detail { align-items: flex-start; display: flex; gap: .85rem; }
  .english-letter__event-detail + .english-letter__event-detail { border-left: 1px solid var(--color-line); margin-left: clamp(1rem, 3vw, 2rem); padding-left: clamp(1rem, 3vw, 2rem); }
  .english-letter__event-detail svg { fill: none; flex: 0 0 auto; height: 1.25rem; margin-top: .15rem; stroke: var(--color-accent); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; width: 1.25rem; }
  .english-letter__event-detail p { display: grid; font-family: var(--font-body); font-size: var(--size-sm); gap: .15rem; line-height: 1.35; margin: 0; }
  .english-letter__event-detail strong { color: var(--color-accent); font-size: .66rem; letter-spacing: .13em; margin-bottom: .2rem; text-transform: uppercase; }
  .english-letter__event-detail span { color: var(--color-ink); }
  .english-letter__event-detail em { color: var(--color-muted); font-size: .78rem; font-style: italic; }
  .english-letter__signup { align-items: center; background: var(--color-accent); border-radius: .7rem; box-shadow: 0 0 0 rgba(47, 97, 79, 0); color: var(--color-paper); display: flex; font-family: var(--font-body); font-size: var(--size-sm); font-weight: 600; gap: .8rem; justify-content: space-between; letter-spacing: .03em; margin: 0; max-width: 24rem; padding: 1rem 1.15rem 1rem 1.3rem; text-decoration: none; transition: box-shadow .2s ease, filter .2s ease, transform .2s ease; }
  .english-letter__signup:hover { box-shadow: 0 .65rem 1.3rem rgba(47, 97, 79, .22); color: var(--color-paper); filter: brightness(1.1); transform: translateY(-3px); }
  .english-letter__signup span { font-size: 1.35em; line-height: .8; transition: transform .2s ease; }
  .english-letter__signup:hover span { transform: translateX(.3rem); }
  .english-letter__meeting { color: var(--color-muted); font-family: var(--font-body); font-size: .75rem; letter-spacing: .02em; margin: .75rem 0 0 !important; }
  .english-letter__email { margin-top: clamp(3.5rem, 8vw, 5.5rem); }
  .english-letter__closing { color: var(--color-ink); margin-bottom: 0 !important; }
  .english-letter__content a:not(.english-letter__signup) { color: var(--color-ink); }
  @media (max-width: 48rem) { .english-intro__warrior { max-width: min(82vw, 22rem); } }
  @media (max-width: 36rem) {
    .english-letter__event-details { gap: 1.25rem; grid-template-columns: 1fr; }
    .english-letter__event-detail + .english-letter__event-detail { border-left: 0; border-top: 1px solid var(--color-line); margin-left: 0; padding-left: 0; padding-top: 1.25rem; }
    .english-letter__signup { max-width: none; width: 100%; }
  }
</style>
