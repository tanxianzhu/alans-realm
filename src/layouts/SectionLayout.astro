---
import { withBase } from '../lib/path';
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  introduction: string;
  section: string;
  heroImage?: string;
  heroImageAlt?: string;
}
const { title, introduction, section, heroImage, heroImageAlt = '' } = Astro.props;
---
<BaseLayout title={`${title} — Alan's Realm`} description={introduction} currentSection={section}>
  <section class:list={['site-shell', 'page-intro', `page-intro--${section}`, heroImage && 'page-intro--with-image']}>
    <div class="page-intro__text">
      <p class="page-intro__eyebrow">Alan's Realm · {section}</p>
      <h1>{title}</h1>
      {introduction && <p>{introduction}</p>}
    </div>
    {heroImage && (
      <div class="page-intro__hero">
        <img src={withBase(heroImage)} alt={heroImageAlt} loading="eager" />
      </div>
    )}
  </section>
  <section class="site-shell"><slot /></section>
</BaseLayout>

<style>
  .page-intro--with-image {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .page-intro--economics .page-intro__hero { max-width: clamp(17rem, 34vw, 30rem); }
  .page-intro--art .page-intro__hero { max-width: clamp(12rem, 21vw, 19rem); }
  .page-intro--wonder { grid-template-columns: 1fr; }
  .page-intro--wonder .page-intro__hero { margin-top: var(--space-3); max-width: min(72vw, 32rem); }
  .page-intro__hero img {
    display: block;
    height: auto;
    width: 100%;
  }
  @media (max-width: 48rem) {
    .page-intro--with-image {
      grid-template-columns: 1fr;
    }
    .page-intro__hero { margin: var(--space-3) 0 0; }
    .page-intro--economics .page-intro__hero { max-width: min(72vw, 22rem); }
    .page-intro--art .page-intro__hero { max-width: min(58vw, 17rem); }
    .page-intro--wonder .page-intro__hero { max-width: min(82vw, 25rem); }
  }
</style>
