---
interface Item {
  question: string;
  consequence: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="risk-list">
  {items.map((item, index) => (
    <li>
      <span class="risk-list__number">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <p class="risk-list__question">{item.question}</p>
        <p class="risk-list__consequence">{item.consequence}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .risk-list { border-top: 1px solid var(--color-line); list-style: none; margin: var(--space-3) 0 var(--space-4); padding: 0; }
  .risk-list li { border-bottom: 1px solid var(--color-line); display: grid; gap: var(--space-2); grid-template-columns: 2.5rem 1fr; padding: 1.15rem 0; }
  .risk-list p { margin: 0; }
  .risk-list__number { color: var(--color-muted); font-family: var(--font-body); font-size: var(--size-xs); letter-spacing: .08em; padding-top: .3rem; }
  .risk-list__question { color: var(--color-ink); font-weight: 700; line-height: 1.45; }
  .risk-list__consequence { color: var(--color-muted); font-family: var(--font-display); font-size: 1.1rem; line-height: 1.45; margin-top: .35rem; }
</style>
