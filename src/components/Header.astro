---
import { withBase } from '../lib/path';
const { currentSection, isHome = false } = Astro.props;
const navItems = [
  { id: 'english', label: 'English Corner', href: '/english/' },
  { id: 'economics', label: 'Economics', href: '/economics/' },
  { id: 'art', label: 'Art', href: '/art/' },
  { id: 'wonder', label: 'Fields of Wonder', href: '/wonder/' },
];
---
<header class:list={['header', isHome && 'header--home']}>
  <div class="header__inner site-shell">
    <a class="brand" href={withBase('/')}>Homepage</a>
    <nav class="header__nav" aria-label="Main navigation">
      {navItems.map((item) => <a class:list={[currentSection === item.id && 'active']} href={withBase(item.href)}>{item.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary>Explore <span aria-hidden="true">+</span></summary>
      <nav aria-label="Main navigation">
        {navItems.map((item) => <a class:list={[currentSection === item.id && 'active']} href={withBase(item.href)}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<style>
  .header { background: color-mix(in srgb, var(--color-paper) 92%, transparent); border-bottom: 1px solid var(--color-line); position: relative; z-index: 2; }
  .header__inner { align-items: center; display: flex; justify-content: space-between; max-width: none; padding: 1.15rem 0 1.05rem; width: calc(100% - 4rem); }
  .brand { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -.02em; text-decoration: none; }
  .header__nav { display: flex; gap: clamp(1rem, 2vw, 1.8rem); margin-left: auto; }
  .header__nav a, .mobile-nav nav a { color: var(--color-muted); font-size: var(--size-xs); letter-spacing: .12em; padding: .35rem 0; text-decoration: none; text-transform: uppercase; }
  .header__nav a:hover, .header__nav a.active, .mobile-nav nav a:hover, .mobile-nav nav a.active { color: var(--color-ink); text-decoration: none; }
  .header__nav a.active, .mobile-nav nav a.active { border-bottom: 1px solid currentColor; }
  .mobile-nav { display: none; }
  .header--home { backdrop-filter: blur(14px); background: rgba(22, 29, 24, .32); border-bottom-color: rgba(248, 244, 233, .3); left: 0; position: absolute; right: 0; top: 0; z-index: 1; }
  .header--home .brand, .header--home .header__nav a, .header--home .mobile-nav nav a { color: #f8f4e9; }
  .header--home .header__nav a:hover, .header--home .header__nav a.active, .header--home .mobile-nav nav a:hover, .header--home .mobile-nav nav a.active { color: #fffdf8; }
  @media (max-width: 40rem) {
    .header__inner { align-items: center; padding: .8rem 0; width: calc(100% - 2.5rem); }
    .header__nav { display: none; }
    .mobile-nav { display: block; margin-left: auto; position: relative; }
    .mobile-nav summary { color: var(--color-muted); cursor: pointer; font-family: var(--font-body); font-size: .67rem; letter-spacing: .12em; list-style: none; padding: .35rem 0; text-transform: uppercase; }
    .mobile-nav summary::-webkit-details-marker { display: none; }
    .mobile-nav summary span { color: var(--color-accent); display: inline-block; font-size: 1rem; line-height: .6; margin-left: .3rem; transition: transform .2s ease; }
    .mobile-nav[open] summary span { transform: rotate(45deg); }
    .mobile-nav nav { background: var(--color-paper); border: 1px solid var(--color-line); border-radius: .7rem; box-shadow: 0 .75rem 1.8rem rgba(32, 33, 29, .12); display: grid; gap: .25rem; min-width: 11.5rem; padding: .5rem .8rem; position: absolute; right: 0; top: calc(100% + .45rem); z-index: 3; }
    .mobile-nav nav a { border-bottom: 0; padding: .45rem 0; }
  }
  @media (max-width: 28rem) { .header__inner { padding: .75rem 0; } .brand { font-size: 1.08rem; } }
</style>
