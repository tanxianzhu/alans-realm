---
interface Props {
  transcript: string[];
}

const { transcript } = Astro.props;
---

<section class="answer-transcript" aria-labelledby="answer-transcript-title" data-answer-transcript>
  <header class="answer-transcript__header">
    <p class="answer-transcript__eyebrow">Full transcript</p>
    <h2 id="answer-transcript-title">Alan's answer, word for word.</h2>
  </header>
  <div class="answer-transcript__body">
    {transcript.map((paragraph, index) => (
      <p class="answer-transcript__paragraph">
        <span class="answer-transcript__number">{String(index + 1).padStart(2, '0')}</span>
        <span class="answer-transcript__text">{paragraph}</span>
      </p>
    ))}
  </div>
</section>

<style>
  .answer-transcript {
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(3rem, 8vw, 6rem);
  }
  .answer-transcript__header {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .answer-transcript__eyebrow {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .answer-transcript h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    max-width: 14ch;
  }
  .answer-transcript__body {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    max-width: 44rem;
  }
  .answer-transcript__paragraph {
    align-items: start;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    display: grid;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    gap: 1.25rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    line-height: 1.6;
    padding: 1.25rem 0;
    text-align: left;
    margin: 0;
    width: 100%;
  }
  .answer-transcript__number {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    padding-top: 0.35rem;
  }
  .answer-transcript__text {
    color: inherit;
  }
  @media (max-width: 36rem) {
    .answer-transcript__paragraph {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
