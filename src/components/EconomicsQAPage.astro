---
import type { EconomicsQuestion, QuestionGroup } from '../data/economics-qa';
import { withBase } from '../lib/path';
import QuestionRow from './qa/QuestionRow.astro';
import '../styles/qa.css';

interface Props {
  questions: EconomicsQuestion[];
  groups: QuestionGroup[];
}

const { questions, groups } = Astro.props;
const groupedQuestions = groups
  .map((group) => ({ group, questions: questions.filter((question) => question.groupId === group.id) }))
  .filter(({ questions: groupQuestions }) => groupQuestions.length);
const ungroupedQuestions = questions.filter((question) => !question.groupId);
const envelopeImage = withBase('/images/qa/question-envelope/envelope-closed-source.png');
---

<div class="qa-page-content">
  <section class="qa-hero qa-shell" aria-labelledby="public-questions">
    <p class="qa-eyebrow">Alan’s Economics Commons</p>
    <h1 id="public-questions">Public<br />questions.</h1>
    <p class="qa-intro">A growing collection of questions, conversations, and answers worth sharing.</p>
  </section>

  <section class="qa-list qa-shell" aria-label="Public questions">
    {groupedQuestions.map(({ group, questions: groupQuestions }) => (
      <section class="qa-question-group" aria-labelledby={`group-${group.id}`}>
        <div class="qa-question-group__heading">
          <h2 id={`group-${group.id}`}>{group.name}</h2>
          <span>{String(groupQuestions.length).padStart(2, '0')}</span>
        </div>
        <ol>
          {groupQuestions.map((question, index) => <QuestionRow question={question} number={index + 1} />)}
        </ol>
      </section>
    ))}
    {ungroupedQuestions.length > 0 && (
      <section class="qa-question-group" aria-labelledby="group-other">
        <div class="qa-question-group__heading">
          <h2 id="group-other">More questions</h2>
          <span>{String(ungroupedQuestions.length).padStart(2, '0')}</span>
        </div>
        <ol>
          {ungroupedQuestions.map((question, index) => <QuestionRow question={question} number={index + 1} />)}
        </ol>
      </section>
    )}
  </section>

  <section class="qa-contact qa-shell" aria-labelledby="contact-alan">
    <div class="qa-contact__copy">
      <p class="qa-eyebrow">A question of your own?</p>
      <h2 id="contact-alan">Start a conversation with Alan.</h2>
      <p>Reach Alan on WeChat to share a new question. The best ones may find a home here.</p>
    </div>
    <img class="qa-contact__envelope" src={envelopeImage} alt="A sealed envelope" loading="lazy" />
  </section>
</div>
