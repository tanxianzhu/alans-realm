---
const { children } = Astro.props;
---
<aside class="think" aria-label="Think about it">
  <p class="think__label">Think about it <span aria-hidden="true">🤔</span></p>
  <div class="think__body"><slot /></div>
</aside>
<style>
  .think { border-top: 1px solid var(--color-accent); border-bottom: 1px solid var(--color-accent); margin: var(--space-5) 0; padding: var(--space-3) 0 var(--space-2); }
  .think__label { color: var(--color-accent); font-size: var(--size-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .think__body :global(p) { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.45; }
</style>
